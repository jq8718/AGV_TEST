CONFIG_IDF_TARGET="esp32p4"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_EN=n

# OV9281: 2-lane MIPI CSI, 24 MHz XCLK, 1280x720 RAW8 at 50 fps.
CONFIG_P4SCAN_CAMERA_APP=y
CONFIG_P4SCAN_CONTINUOUS_SCAN=y
CONFIG_P4SCAN_QR_FAST_SEARCH=y
CONFIG_P4SCAN_TRIGGER_GPIO=35
CONFIG_P4SCAN_LIGHT_DIAGNOSTIC=n
CONFIG_P4SCAN_SOFTWARE_TRIGGER_ON_BOOT=n
CONFIG_P4SCAN_DUMP_FRAME_TO_FLASH=n
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_ESP_VIDEO_DISABLE_MIPI_CSI_DRIVER_BACKUP_BUFFER=y
CONFIG_TINYUSB_RHPORT_HS=y
CONFIG_TUSB_PID=0x8001
CONFIG_UVC_MODE_ISOC_CAM1=y
CONFIG_UVC_CAM1_FRAMESIZE_WIDTH=1024
CONFIG_UVC_CAM1_FRAMESIZE_HEIGT=1024
CONFIG_UVC_CAM1_MULTI_FRAMESIZE=n
CONFIG_UVC_TINYUSB_TASK_CORE=0
CONFIG_UVC_CAM1_TASK_CORE=0
CONFIG_UVC_CAM1_FRAMERATE=30
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U32=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

CONFIG_UVC_TINYUSB_TASK_PRIORITY=10

CONFIG_UVC_CAM1_TASK_PRIORITY=9

# CONFIG_UVC_MODE_BULK_CAM1 is not set

CONFIG_P4SCAN_FRAME_STAGE_PIPELINE=y
# CONFIG_P4SCAN_PIPELINE_DIAGNOSTICS is not set

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP32P4_REV_MIN_301=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
CONFIG_RTC_CLK_SRC_EXT_CRYS=y
CONFIG_RTC_CLK_CAL_CYCLES=3000
CONFIG_CAMERA_OV01C1B=y
CONFIG_CAMERA_OV01C1B_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV01C1B_MIPI_RAW10_1024X1024_50FPS=y
CONFIG_CAMERA_OV01C1B_MIPI_DEFAULT_FMT_RAW10_1024X1024_50FPS=y
CONFIG_CAMERA_OV01C1B_MIPI_CLK_MHZ=1300
CONFIG_CAMERA_OV01C1B_AE_MAX_EXPOSURE_US=10000
CONFIG_CAMERA_OV01C1B_AE_MAX_GAIN=15
CONFIG_TUSB_PRODUCT="AGV SCAN E6 UVC+CDC"
